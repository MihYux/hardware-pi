# 对外服务
HARDWARE_PI_HOST=0.0.0.0
HARDWARE_PI_PORT=8000
HARDWARE_PI_WORKBENCH_PORT=3000
HARDWARE_PI_DATA_DIR=/data

# 管理面板与设备访问令牌。部署前必须替换。
HARDWARE_PI_ADMIN_TOKEN=replace-with-a-long-random-admin-token
HARDWARE_PI_DEVICE_TOKEN=replace-with-a-long-random-device-token
HARDWARE_PI_SERVICE_TOKEN=replace-with-a-long-random-service-token

# 首次启动时写入统一控制面的初始配置，后续可在网页管理面板修改。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

ZHIPU_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

DASHSCOPE_API_KEY=
COSYVOICE_MODEL=cosyvoice-v3.5-flash
