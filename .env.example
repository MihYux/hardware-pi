# 对外服务
HARDWARE_PI_HOST=0.0.0.0
HARDWARE_PI_PORT=8000
HARDWARE_PI_WORKBENCH_PORT=3000
HARDWARE_PI_DATA_DIR=/data

# 默认只在可信局域网运行，不要求网页令牌。需要鉴权时改为 token 并填写三个令牌。
HARDWARE_PI_AUTH_MODE=off
HARDWARE_PI_ADMIN_TOKEN=
HARDWARE_PI_DEVICE_TOKEN=
HARDWARE_PI_SERVICE_TOKEN=

# 首次启动时写入统一控制面的初始配置，后续可在网页管理面板修改。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

ZHIPU_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

DASHSCOPE_API_KEY=
COSYVOICE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
COSYVOICE_MODEL=cosyvoice-v3.5-flash
COSYVOICE_VOICE_ID=cosyvoice-v3.5-flash-marchpet-eb86bcaeea5f40669b1798191950529a
