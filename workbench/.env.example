# 仅供脱离 Docker 调试工作台；正式部署由根目录 docker-compose.yml 注入。
HARDWARE_PI_GATEWAY=1
AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=<HARDWARE_PI_SERVICE_TOKEN>
DEEPSEEK_MODEL=hardware-pi-router
DEEPSEEK_BASE_URL=http://127.0.0.1:8000/api/openai/v1

ZHIPU_API_KEY=<HARDWARE_PI_SERVICE_TOKEN>
GLM_MODEL=hardware-pi-zhipu-router
GLM_BASE_URL=http://127.0.0.1:8000/api/zhipu/v1

DATA_DIR=.data
